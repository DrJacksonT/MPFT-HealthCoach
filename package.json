{
  "name": "mpft-evidence-coach-smoking-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "evidence:freshness": "node scripts/check-evidence-freshness.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "account:provision": "tsx scripts/provision-account.ts",
    "auth:smoke": "tsx scripts/auth-smoke.ts",
    "auth:smoke:deployment": "tsx scripts/deployment-auth-smoke.ts",
    "surveys:schedule": "tsx scripts/schedule-surveys.ts",
    "report:synthetic": "tsx scripts/generate-pilot-report.ts",
    "backup:pglite": "tsx scripts/pglite-backup.ts",
    "restore:pglite": "tsx scripts/pglite-restore.ts",
    "retention:dry-run": "tsx scripts/run-retention.ts",
    "retention:apply": "cross-env RETENTION_APPLY=true tsx scripts/run-retention.ts",
    "rights:dry-run": "tsx scripts/process-rights-requests.ts",
    "rights:apply:synthetic": "cross-env RIGHTS_APPLY=true tsx scripts/process-rights-requests.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "sbom": "tsx scripts/generate-sbom.ts",
    "e2e:prepare": "cross-env PGLITE_DATA_DIR=.data/mpft-e2e-test tsx scripts/reset-e2e-store.ts && cross-env PGLITE_DATA_DIR=.data/mpft-e2e-test npm run db:migrate && cross-env PGLITE_DATA_DIR=.data/mpft-e2e-test E2E_SEED_DUE=true npm run db:seed",
    "e2e": "npm run e2e:prepare && playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@mpft/database-runtime": "file:packages/database-runtime",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "otpauth": "^9.4.1",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.53.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "type": "module"
}
