# Standalone local database. Omit to use the PostgreSQL-compatible PGlite store.
DATABASE_URL=
PGLITE_DATA_DIR=.data/mpft-pglite

# Public origin and session protection. Generate unique production values.
APP_ORIGIN=http://localhost:3000
RELEASE_ENVIRONMENT=local
SESSION_HASH_KEY=local-development-session-key-change-before-production
FIELD_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12

# Local mail defaults to an auditable file sink. Set SMTP_* for Mailpit or a provider.
MAIL_TRANSPORT=file
MAIL_FILE_DIR=.data/mail
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=MPFT research test <research-test@example.invalid>

# Environment flags are necessary but never sufficient: a matching named, dated
# database release is also required. Safe defaults keep every live path closed.
LIVE_PILOT_ENABLED=false
LIVE_AI_ENABLED=false
GAMBLING_PARTICIPANT_ENABLED=false

# Optional. The structured programme works without an API key.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6-luna
OPENAI_STUDY_BUDGET_USD=0
OPENAI_INPUT_USD_PER_1M=0
OPENAI_OUTPUT_USD_PER_1M=0
OPENAI_TIMEOUT_MS=20000
RAW_COACH_TEXT_STORAGE_ENABLED=false
DISCLOSURE_MIN_CELL=5

# Development-only synthetic staff second factor. Production refuses this adapter.
STAFF_MFA_PROVIDER=development_totp

# Operations scripts default to dry-run. Apply modes are synthetic/local only
# unless a separately approved production runbook explicitly replaces them.
RETENTION_SESSION_DAYS=30
